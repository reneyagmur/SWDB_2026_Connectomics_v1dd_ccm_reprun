#!/usr/bin/env bash
set -euo pipefail

# One timestamp drives everything below, so the asset name, the output directory and
# processing.json all agree on when this run started.
RUN_EPOCH=$(date -u +%s)
RUN_START=$(date -u -d "@$RUN_EPOCH" +%Y-%m-%dT%H:%M:%SZ)     # ISO, for processing.json
ASSET_STAMP=$(date -u -d "@$RUN_EPOCH" +%Y-%m-%d_%H-%M-%S)    # AIND DataRegex.DATA form

# Flat layout: the CCM tables and the AIND metadata sidecars both live at the asset
# root, so /results *is* the asset and data_description.name describes it directly.
export CCC_OUTPUT_ROOT="/results"

# The asset name is now a label rather than a directory, so it is passed explicitly to
# metadata.py. DataRegex.DATA form: <label>_<YYYY-MM-DD_HH-MM-SS>.
ASSET_NAME="409828_V1DD_CCM_materialization_1196_${ASSET_STAMP}"
echo "Output asset: $ASSET_NAME  (written to $CCC_OUTPUT_ROOT)"

# ETL notebooks — must run in order: 01-03 write data; 04 reads/validates
jupyter nbconvert --to notebook --execute --ExecutePreprocessor.timeout=-1 \
    --output-dir /results \
    "/code/etl_v1dd_01_cave_dataset_celltypes.ipynb"

jupyter nbconvert --to notebook --execute --ExecutePreprocessor.timeout=-1 \
    --output-dir /results \
    "/code/etl_v1dd_02_synapses.ipynb"

jupyter nbconvert --to notebook --execute --ExecutePreprocessor.timeout=-1 \
    --output-dir /results \
    "/code/etl_v1dd_03_somafeatures.ipynb"

# AIND metadata sidecars: subject.json, data_description.json, processing.json.
# Written to /results (the data asset root), not into the CCM output_root.
python -u /code/metadata.py --start-time "$RUN_START" --asset-name "$ASSET_NAME"
